<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>VoicemeeterSliderControl</AssemblyName>
    <RootNamespace>VoicemeeterSliderControl</RootNamespace>
    <Version>0.0.7</Version>
    <AssemblyVersion>0.0.7.0</AssemblyVersion>
    <FileVersion>0.0.7.0</FileVersion>
    <InformationalVersion>0.0.7</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="VoicemeeterRemote" Version="2.0.0" />
    <EmbeddedResource Include="icon.ico" />
    <EmbeddedResource Include="icon_connected.ico" />
  </ItemGroup>

</Project>
